# ─────────────────────────────────────────────────────────────────────────────
# The Forge — environment configuration
#
# The Forge assumes its environment (§9.5: fail loud, don't degrade through
# ladders). Set what you need; missing-but-required values crash loudly at
# startup with a clear message rather than silently no-op'ing.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM (the Warden's reasoning) — multi-provider, mirrors Mark VI ───────────
# A profile's model is a "provider:model" ref (bare name → Anthropic). Set the
# key for whichever providers your agent profiles use. The demo
# (`python -m forge demo`) runs on a deterministic scripted model and needs NONE.
#   Anthropic → ANTHROPIC_API_KEY  (bare refs, e.g. claude-sonnet-4-6)
#   OpenAI    → OPENAI_API_KEY     (openai:gpt-5.1, openai:gpt-5-mini)
#   Gemini    → GEMINI_API_KEY     (gemini:gemini-2.5-pro, gemini:gemini-2.5-flash)
#   z.ai      → ZAI_API_KEY        (zai:glm-4.6)
#   DeepSeek  → DEEPSEEK_API_KEY   (deepseek:deepseek-v4-pro)
#   Ollama    → no key, just OLLAMA_BASE_URL (ollama:llama3.1:8b)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ZAI_API_KEY=
DEEPSEEK_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1
# Optional provider redundancy — comma-separated "provider:model" refs tried in
# order when the primary provider fails to open a stream. Empty = off (fail loud).
FORGE_LLM_FALLBACK_CHAIN=

# ── SPEDA Mark VI link (§7 wire contract, §9.2 graceful fallback) ────────────
# When present, the Gate connects to Mark VI's agents WebSocket as a peer and
# speaks its protocol (agent_register / task_dispatch / chat_request →
# task_result / chat_event). Same key Mark VI validates on every HTTP request.
SPEDA_API_KEY=
# Mark VI agents WS endpoint. agent_id in the path is set by the launched agent.
SPEDA_WS_URL=ws://127.0.0.1:8000/agents/ws/optimus

# ── Which MACHINE this peer speaks for ───────────────────────────────────────
# Optimus is ONE agent that may run in several places at once — on the server
# and on the owner's PC. Mark VI keys connections by (agent_id, host) so those
# coexist, but only if each peer says which machine it is. Blank → the bare
# hostname, which is already unique on any network that can reach Mark VI. Set
# it to name a box deliberately.
FORGE_HOST=
# Directories this peer will work in, os.pathsep-separated (`;` on Windows,
# `:` on Linux). Mark VI routes by path — the owner picks a folder and the
# folder identifies the machine. Blank means "anything well-formed for my
# platform", which is what the server peer wants and why it needs none.
#
# Advertising is not enforcement: these are routing hints. What a peer will
# actually do is bounded on the peer, by its own tools and permission gate.
FORGE_ROOTS=

# ── H.İ.S.A.R. — the owner's file vault ──────────────────────────────────────
# The machine token. Unset → hisar_list / hisar_read / hisar_deposit are
# WITHHELD entirely rather than offered and failing, so an agent is never given
# a door it has no key to. This is the whole of the difference between a Forge
# that can reach the vault and one that cannot — there is no other switch.
HISAR_MACHINE_TOKEN=
# Blank → https://hisar.spedatox.systems
HISAR_URL=

# ── Research tools (harness-side, not in the Cell) ───────────────────────────
# Required by web_search and web_fetch. These run in the Forge process, so an
# agent can consult documentation while its Cell stays without network.
TAVILY_API_KEY=

# ── Telling the owner a dispatched job finished ──────────────────────────────
# A job dispatched to a box nobody is logged into otherwise completes only as a
# journal line. Both must be set for the notification to send.
#
# FORGE_TELEGRAM_TOKEN_<AGENT> (uppercased agent id, hyphens as underscores)
# gives one agent its own bot; the bare name below is the fallback for a
# single-bot deployment.
FORGE_TELEGRAM_TOKEN=
FORGE_TELEGRAM_CHAT_ID=
# Set to any value to suppress those notifications without unsetting the token.
FORGE_NO_TELEGRAM=

# ── Cell isolation (§8) ──────────────────────────────────────────────────────
# "docker"     — production default: one throwaway container per agent,
#                --network none, resource-capped, non-root (matches Mark VI's
#                own packages/sandbox posture).
# "subprocess" — reduced-isolation fallback for Docker-less dev/CI. Same
#                Cell contract; jailed to a per-agent workspace, wall-clock and
#                output capped. NOT a security boundary against hostile code.
# "auto"       — docker if the daemon is reachable, else subprocess (logged).
FORGE_CELL_BACKEND=auto
# Absolute path under which per-agent workspaces are created. One Cell per
# agent, never shared (§9.1).
FORGE_WORKSPACE_ROOT=./.forge/workspaces
# Docker image for DockerCell. Must have the agent's toolchain installed.
FORGE_CELL_IMAGE=python:3.12-slim

# ── Graphify sidecar (§5) ────────────────────────────────────────────────────
# Path to the `graphify` executable (pip package `graphifyy`). Blank → resolve
# from PATH. The graph is indexed once per session against the job's repo.
FORGE_GRAPHIFY_BIN=

# ── Claude Code (via free-claude-code proxy) ───────────────────────────────────
# The `claude_code` tool delegates to the real Claude Code CLI. The CLI's API
# calls route through fcc-server, which is the free-claude-code proxy running
# on the host. From inside a Docker Cell, the host is reachable at the Docker
# bridge gateway. Override this only when the proxy is on a different host or
# port — the default is correct for the standard Docker bridge setup.
CLAUDE_CODE_SERVER_URL=http://172.17.0.1:8082
# ── The rest ─────────────────────────────────────────────────────────────────
# Default agent for `forge chat` / `forge connect` when --agent is not given.
FORGE_AGENT=optimus
# Persisted operation approvals ("don't ask me again").
FORGE_ALLOWLIST_PATH=./.forge/allowlist.json
# DEBUG / INFO / WARNING. The REPL silences the harness's own loggers unless
# this is set, so a traceback cannot land in the middle of a conversation.
FORGE_LOG_LEVEL=INFO
# Set to any value to suppress the status line above the prompt.
FORGE_NO_STATUS=
# Set to any value to stop the terminal bell when a long turn finishes.
FORGE_NO_BELL=
